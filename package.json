{
  "name": "@happ-ai/labs-ui",
  "version": "0.1.1",
  "description": "Labs design system (labs.happ.tools): tokens, primitives, shell and auth screens. Ships TypeScript source.",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "!src/*.mp4",
    "!src/test-setup.ts",
    "!src/storybook.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.500.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-day-picker": "^9.14.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Happ-AI/labs-ui.git"
  },
  "license": "UNLICENSED"
}
